<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Ti</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@400;600&display=swap" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            /* El fondo inicial es un gris suave, serio y melancólico */
            background: #eceff1;
            font-family: 'Quicksand', sans-serif;
            color: #455a64;
            text-align: center;
            overflow: hidden;
            position: relative;
            padding: 20px;
            transition: background 1s ease;
        }
        
        /* Fondo animado que se activa después del click */
        body.amor-activo {
            background: linear-gradient(-45deg, #ff9a9e, #fecfef, #feada6, #f3a6b5);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 40px 30px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            max-width: 420px;
            width: 100%;
            z-index: 10;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        
        .container.shaking {
            animation: tremor 0.4s ease;
        }
        @keyframes tremor {
            0% { transform: translateX(0); }
            20% { transform: translateX(-10px); }
            40% { transform: translateX(10px); }
            60% { transform: translateX(-10px); }
            80% { transform: translateX(10px); }
            100% { transform: translateX(0); }
        }

        h1 {
            font-size: 2.2rem;
            margin: 0 0 20px 0;
            font-weight: 600;
            transition: all 0.5s ease;
        }
        
        h1.cambio-texto {
            font-family: 'Dancing Script', cursive;
            font-size: 3.5rem;
            color: #d63384;
        }

        /* Botón interactivo de corazón roto al inicio */
        .btn-corazon {
            background: none;
            border: none;
            font-size: 4.5rem;
            cursor: pointer;
            outline: none;
            display: inline-block;
            animation: latidoSuave 2s infinite;
            transition: transform 0.2s;
        }
        .btn-corazon:hover {
            transform: scale(1.1);
        }
        @keyframes latidoSuave {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .mensaje-oculto {
            display: none;
            font-size: 1.15rem;
            color: #555555;
            line-height: 1.6;
            border-top: 1px dashed #ffb3c6;
            text-align: left;
            margin-top: 25px;
            padding-top: 20px;
            animation: fadeIn 0.8s ease forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .corazon-flotante {
            position: absolute;
            bottom: -50px;
            pointer-events: none;
            animation: flotar 4s linear forwards;
            z-index: 1;
        }
        @keyframes flotar {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-105vh) rotate(360deg); opacity: 0; }
        }
    </style>
</head>
<body>

    <div class="container" id="cartaContainer">
        <h1 id="tituloPrincipal">Ya no te quiero...</h1>
        
        <button class="btn-corazon" id="btnCorazon" onclick="revelarVerdad()">💔</button>
        
        <div id="carta" class="mensaje-oculto">
            Hola, te dejo esto por acá porque quería que fuera lo primero que veas al despertar. Quería recordarte lo mucho que te amo y lo lindo que es tenerte en mi vida. Que tengas un día hermoso hoy, te mando un beso enorme y me avisas cuando lo leas.
        </div>
    </div>

    <!-- Música de fondo oculta (Servidor estable) -->
    <audio id="musicaFondo" loop preload="auto">
        <source src="https://soundhelix.com" type="audio/mpeg">
    </audio>

    <script>
        function revelarVerdad() {
            const container = document.getElementById('cartaContainer');
            const titulo = document.getElementById('tituloPrincipal');
            const btn = document.getElementById('btnCorazon');
            const carta = document.getElementById('carta');
            const musica = document.getElementById('musicaFondo');

            // 1. Efecto de temblor en la tarjeta
            container.classList.add('shaking');

            // 2. Transformar el entorno tras el temblor
            setTimeout(() => {
                // Activar fondo de colores de amor
                document.body.classList.add('amor-activo');
                
                // Cambiar el título con estilo elegante
                titulo.innerText = "...¡PORQUE AHORA TE AMO!";
                titulo.classList.add('cambio-texto');
                
                // Cambiar el corazón roto por uno latiendo brillante
                btn.innerText = "💖";
                btn.style.animation = "latidoRapido 0.6s infinite";
                
                // Mostrar el texto de buenos días abajo
                carta.style.display = 'block';

                // Iniciar la música nativa
                musica.play().catch(error => console.log("Audio desbloqueado"));

                // Iniciar la lluvia intensa de corazones
                setInterval(crearCorazon, 250);
            }, 400);
        }

        function crearCorazon() {
            const corazon = document.createElement('div');
            corazon.classList.add('corazon-flotante');
            const tipos = ['❤️', '💖', '💝', '💕', '🌸', '✨'];
            corazon.innerText = tipos[Math.floor(Math.random() * tipos.length)];
            corazon.style.left = Math.random() * 100 + 'vw';
            corazon.style.fontSize = Math.random() * 20 + 15 + 'px';
            corazon.style.animationDuration = Math.random() * 2 + 3 + 's';
            document.body.appendChild(corazon);
            setTimeout(() => { corazon.remove(); }, 4500);
        }
    </script>

    <!-- Regla CSS extra para el nuevo corazón latiendo rápido -->
    <style>
        @keyframes latidoRapido {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
    </style>

</body>
</html>
